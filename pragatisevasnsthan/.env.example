# Copy this file to .env and fill values. NEVER upload .env to git / share it.
APP_ENV=local
APP_DEBUG=1
# No trailing slash. XAMPP example: http://localhost/pragatisevasnsthan   Live: https://pragatisevasnsthan.com
APP_URL=http://localhost/pragatisevasnsthan

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pragatisnsthadb
DB_USER=root
DB_PASS=

# Set 1 only when site is behind Cloudflare / proxy (then real visitor IP is read from CF header)
TRUST_PROXY=0

# Admin session idle timeout (minutes)
SESSION_IDLE_MIN=30

# Razorpay / SMTP keys are now entered by Super Admin in Admin > Settings (stored encrypted in the database).
# These .env lines are only an optional fallback - leave blank normally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Optional: any long random text. If blank, an encryption key file is auto-created at storage/app.key
# (BACKUP storage/app.key with your database - without it saved Razorpay/SMTP secrets cannot be decrypted).
ENCRYPTION_KEY=
